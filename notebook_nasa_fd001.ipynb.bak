    "# Plot RUL real vs predicho con LSTM — mismo motor\n",
    "eid_plot = meta_test['engine_id'].value_counts().idxmax()\n",
    "\n",
    "test_meta_named = meta_test.reset_index(drop=True)\n",
    "X_test_w_named, y_test_w_named = build_windows(X_test, y_test, test_meta_named)\n",
    "pred_test_named = model_lstm.predict(X_test_w_named, verbose=0).ravel()\n",
    "\n",
    "# Mapear predicción de ventanas al motor del último ciclo\n",
    "window_to_last_cycle = []\n",
    "for i, (eid, cyc) in enumerate(zip(test_meta_named['engine_id'], test_meta_named['cycle'])):\n",
    "    pass\n",
    "\n",
    "# Reconstruir mejor: predicciones por motor directamente\n",
    "rows = []\n",
    "unique_ids = np.unique(test_meta_named['engine_id'].values)\n",
    "idx = 0\n",
    "for eid in unique_ids:\n",
    "    mask_e = test_meta_named['engine_id'].values == eid\n",
    "    seg_len = mask_e.sum()\n",
    "    if seg_len < WINDOW:\n",
    "        continue\n",
    "    n_win = seg_len - WINDOW + 1\n",
    "    for w in range(n_win):\n",
    "        rows.append({\n",
    "            'engine_id': eid,\n",
    "            'last_cycle': test_meta_named.loc[mask_e, 'cycle'].values[WINDOW-1+w],\n",
    "            'pred': pred_test_named[idx],\n",
    "        })\n",
    "        idx += 1\n",
    "df_pred = pd.DataFrame(rows)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8,4))\n",
    "sub = df_pred[df_pred['engine_id']==eid_plot]\n",
    "sub2 = test_meta_named[test_meta_named['engine_id']==eid_plot]\n",
    "ax.plot(sub2['cycle'], y_test[sub2.index], 'o-', label='RUL real', linewidth=2)\n",
    "ax.plot(sub['last_cycle'], sub['pred'], 's--', label='LSTM pred', linewidth=1.5, alpha=0.8)\n",
    "ax.set_xlabel('ciclo'); ax.set_ylabel('RUL')\n",
    "ax.set_title(f'Motor {eid_plot} — RUL real vs prediccion (LSTM)')\n",
    "ax.legend()\n",
    "ax.invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
