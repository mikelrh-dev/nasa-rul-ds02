      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Sensores constantes — ruido o senales sin variacion\n",
    "sensor_cols = [c for c in COLS if c.startswith('s')]\n",
    "\n",
    "constante_train = []\n",
    "for c in sensor_cols:\n",
    "    if train[c].nunique() == 1:\n",
    "        constante_train.append(c)\n",
    "\n",
    "print(f'Sensores constantes en train: {len(constante_train)} → {constante_train}')\n",
    "constante_test = [c for c in sensor_cols if test[c].nunique() == 1]\n",
    "print(f'Sensores constantes en test:  {len(constante_test)} → {constante_test}')\n",
    "\n",
    "variabilidad = train[sensor_cols].std().sort_values()\n",
    "fig, ax = plt.subplots(figsize=(6,6))\n",
    "variabilidad.plot(kind='barh', ax=ax)\n",
    "ax.set_title('Desviación estándar por sensor (train)')\n",
    "ax.set_xlabel('std')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
