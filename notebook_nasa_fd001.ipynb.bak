     "output_type": "stream",
     "text": [
      "Sensores constantes en train: 7 → ['setting3', 's1', 's5', 's10', 's16', 's18', 's19']\n",
      "Sensores constantes en test:  7 → ['setting3', 's1', 's5', 's10', 's16', 's18', 's19']\n"
     ]
