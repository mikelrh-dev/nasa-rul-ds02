   },
   "outputs": [],
   "source": [
    "# Metricas LSTM\n",
    "pred_train_lstm = model_lstm.predict(X_train_w, verbose=0).ravel()\n",
    "pred_test_lstm  = model_lstm.predict(X_test_w,  verbose=0).ravel()\n",
    "\n",
    "rmse_train_lstm = np.sqrt(mean_squared_error(y_train_w, pred_train_lstm))\n",
    "rmse_test_lstm  = np.sqrt(mean_squared_error(y_test_w,  pred_test_lstm))\n",
    "mae_test_lstm   = mean_absolute_error(y_test_w, pred_test_lstm)\n",
    "\n",
    "print(f'LSTM  RMSE train: {rmse_train_lstm:.2f}   test: {rmse_test_lstm:.2f}')\n",
    "print(f'LSTM  MAE  test : {mae_test_lstm:.2f}')\n",
    "print(f'Delta train-test : {rmse_test_lstm - rmse_train_lstm:.2f}')\n",
    "\n",
    "model_lstm.save('models/lstm_FD001_2layer.h5')\n",
    "print('Modelo guardado en models/lstm_FD001_2layer.h5')"
   ]
  },
