   "source": [
    "# ¿Cuántos motores y cómo se distribuyen los ciclos?\n",
    "n_motores_train = train['engine_id'].nunique()\n",
    "n_ciclos_train  = len(train)\n",
    "\n",
    "ciclos_por_motor = train.groupby('engine_id')['cycle'].agg(['min','max','count'])\n",
    "ciclos_por_motor['duracion'] = ciclos_por_motor['max'] - ciclos_por_motor['min'] + 1\n",
    "\n",
    "print(f'Motores en train: {n_motores_train}')\n",
    "print(f'Ciclos totales en train: {n_ciclos_train}')\n",
    "print(f'Ciclos por motor — min {ciclos_por_motor[\"duracion\"].min()}, '\n",
    "      f'max {ciclos_por_motor[\"duracion\"].max()}, '\n",
    "      f'media {ciclos_por_motor[\"duracion\"].mean():.1f}')\n",
    "display(ciclos_por_motor.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c06",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-18T19:08:16.068303Z",
     "iopub.status.busy": "2026-10-18T19:08:16.068303Z",
     "iopub.status.idle": "2026-10-18T19:08:16.462134Z",
     "shell.execute_reply": "2026-10-18T19:08:16.461607Z"
    }
   },
