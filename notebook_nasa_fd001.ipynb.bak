    "\n",
    "# Mismo set de features que el baseline: 21 sensores + 3 settings = 24\n",
    "SENSOR_COLS = [c for c in COLS if c.startswith('s')]\n",
    "N_SENSORS = len(SENSOR_COLS)\n",
    "print(f'features: {N_SENSORS} -> {SENSOR_COLS}')\n",
    "\n",
