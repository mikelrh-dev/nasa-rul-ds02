   "source": [
    "# ¿El RUL baja de forma tangible? Ejemplo 3 motores\n",
    "train_sample = train[train['engine_id'].isin([1,2,3])]\n",
    "\n",
    "max_cycle = train.groupby('engine_id')['cycle'].transform('max')\n",
    "train_sample = train_sample.copy()\n",
    "train_sample['RUL'] = max_cycle - train_sample['cycle']\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8,4))\n",
    "for eid in [1,2,3]:\n",
    "    sub = train_sample[train_sample['engine_id']==eid]\n",
    "    ax.plot(sub['cycle'], sub['RUL'], marker='o', label=f'Motor {eid}')\n",
    "ax.set_xlabel('ciclo'); ax.set_ylabel('RUL (ciclos restantes)')\n",
    "ax.set_title('RUL decreciendo — 3 motores de ejemplo')\n",
    "ax.legend()\n",
    "ax.invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c09",
   "metadata": {},
   "source": [
    "## 3. Preprocesamiento\n",
    "\n",
    "Reglas:\n",
    "- `StandardScaler` **fit solo con train** (sin leakage).\n",
    "- RUL = `max_cycle - cycle`.\n",
    "- **Clip a 125**: operaciones con RUL >125 se consideran \"sanas\" y se valora igual (125)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "c10",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-18T19:08:17.521696Z",
     "iopub.status.busy": "2026-10-18T19:08:17.520110Z",
     "iopub.status.idle": "2026-10-18T19:08:18.151829Z",
     "shell.execute_reply": "2026-10-18T19:08:18.151829Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "X_train: (20631, 24) y_train: (20631,)\n",
      "X_test : (13096, 24) y_test : (13096,)\n",
      "RUL train — min 0 max 125 mean 86.8\n",
      "RUL test  — min 0 max 125 mean 69.3\n",
      "Sensor cols used: 24\n"
     ]
    }
   ],
   "source": [
    "CLIP = 125\n",
    "\n",
    "def prepare(df, scaler=None, fit=False):\n",
    "    df = df.copy()\n",
    "    max_cycle = df.groupby('engine_id')['cycle'].transform('max')\n",
    "    df['RUL'] = (max_cycle - df['cycle']).clip(upper=CLIP)\n",
    "    sensor_cols = [c for c in COLS if c.startswith('s')]\n",
    "    X = df[sensor_cols].values\n",
    "    if fit:\n",
    "        scaler = scaler.fit(X)\n",
    "    X_scaled = scaler.transform(X)\n",
    "    y = df['RUL'].values\n",
    "    out = df[['engine_id','cycle']].copy()\n",
    "    out['RUL'] = y\n",
    "    return X_scaled, y, out, scaler\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_train, y_train, meta_train, scaler = prepare(train, scaler=scaler, fit=True)\n",
    "X_test,  y_test,  meta_test,  _       = prepare(test,  scaler=scaler, fit=False)\n",
    "\n",
    "print('X_train:', X_train.shape, 'y_train:', y_train.shape)\n",
    "print('X_test :', X_test.shape,  'y_test :', y_test.shape)\n",
    "print('RUL train — min %.0f max %.0f mean %.1f' % (y_train.min(), y_train.max(), y_train.mean()))\n",
    "print('RUL test  — min %.0f max %.0f mean %.1f' % (y_test.min(),  y_test.max(),  y_test.mean()))\n",
    "print('Sensor cols used:', len([c for c in COLS if c.startswith('s')]))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c11",
   "metadata": {},
   "source": [
    "## 4. Ventanas para LSTM\n",
    "\n",
    "Cada muestra = secuencia de los últimos 30 ciclos del motor → `X.shape = (n_muestras, 30, n_sensores)`.\n",
    "`y` = RUL del **último ciclo** de la ventana."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "c12",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-18T19:08:18.154014Z",
     "iopub.status.busy": "2026-10-18T19:08:18.154014Z",
     "iopub.status.idle": "2026-10-18T19:08:18.251840Z",
     "shell.execute_reply": "2026-10-18T19:08:18.251840Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Ventanas train: (17731, 30, 24) -> y: (17731,)\n",
      "Ventanas test : (10196, 30, 24) -> y: (10196,)\n",
      "Ejemplo X[0].shape: (30, 24)\n",
      "RUL window train mean 80.6\n"
     ]
    }
   ],
   "source": [
    "WINDOW = 30\n",
    "\n",
    "def build_windows(X, y, meta, window=WINDOW):\n",
    "    \"\"\"\n",
    "    Para cada motor: generar ventanas deslizantes de longitud `window`.\n",
    "    Solo ventanas completas. y = RUL del último ciclo.\n",
    "    \"\"\"\n",
    "    X_list, y_list = [], []\n",
    "    # implementacion limpia:\n",
    "    X_list, y_list = [], []\n",
    "    df_meta = meta.reset_index(drop=True)\n",
    "    X = np.asarray(X)\n",
    "    y = np.asarray(y)\n",
    "    \n",
    "    unique_ids = np.unique(df_meta['engine_id'])\n",
    "    for eid in unique_ids:\n",
    "        idx = np.where(df_meta['engine_id'].values == eid)[0]\n",
    "        seg_X = X[idx]\n",
    "        seg_y = y[idx]\n",
    "        if len(seg_X) < window:\n",
    "            continue\n",
    "        for i in range(len(seg_X) - window + 1):\n",
    "            X_list.append(seg_X[i:i+window])\n",
    "            y_list.append(seg_y[i+window-1])\n",
    "    \n",
    "    return np.array(X_list), np.array(y_list)\n",
    "\n",
    "X_train_w, y_train_w = build_windows(X_train, y_train, meta_train, window=WINDOW)\n",
    "X_test_w,  y_test_w  = build_windows(X_test,  y_test,  meta_test,  window=WINDOW)\n",
    "\n",
    "print('Ventanas train:', X_train_w.shape, '-> y:', y_train_w.shape)\n",
    "print('Ventanas test :', X_test_w.shape,  '-> y:', y_test_w.shape)\n",
    "print('Ejemplo X[0].shape:', X_train_w[0].shape)\n",
    "print('RUL window train mean %.1f' % y_train_w.mean())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c13",
   "metadata": {},
   "source": [
    "## 5. Baseline ML — XGBoostRegressor\n",
    "\n",
    "Features = cada ciclo individual escalado (no ventana). Evaluamos RMSE + MAE en test."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "c14",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-18T19:08:18.253877Z",
     "iopub.status.busy": "2026-10-18T19:08:18.253877Z",
     "iopub.status.idle": "2026-10-18T19:08:20.781199Z",
     "shell.execute_reply": "2026-10-18T19:08:20.781199Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "XGBoost  RMSE train: 14.02   test: 52.92\n",
      "XGBoost  MAE  test : 41.29\n",
      "Delta train-test   : 38.91\n",
      "Modelo guardado en models/xgb_FD001_baseline.joblib\n"
     ]
    }
   ],
   "source": [
    "from xgboost import XGBRegressor\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_error\n",
    "\n",
    "xgb = XGBRegressor(\n",
    "    n_estimators=300,\n",
    "    max_depth=6,\n",
    "    learning_rate=0.05,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    ")\n",
    "xgb.fit(X_train, y_train)\n",
    "\n",
    "pred_test_xgb = xgb.predict(X_test)\n",
    "pred_train_xgb = xgb.predict(X_train)\n",
    "\n",
    "rmse_test_xgb  = np.sqrt(mean_squared_error(y_test, pred_test_xgb))\n",
    "mae_test_xgb   = mean_absolute_error(y_test, pred_test_xgb)\n",
    "rmse_train_xgb = np.sqrt(mean_squared_error(y_train, pred_train_xgb))\n",
    "\n",
    "print(f'XGBoost  RMSE train: {rmse_train_xgb:.2f}   test: {rmse_test_xgb:.2f}')\n",
    "print(f'XGBoost  MAE  test : {mae_test_xgb:.2f}')\n",
    "print(f'Delta train-test   : {rmse_test_xgb - rmse_train_xgb:.2f}')\n",
    "\n",
    "import joblib\n",
    "joblib.dump(xgb, 'models/xgb_FD001_baseline.joblib')\n",
    "print('Modelo guardado en models/xgb_FD001_baseline.joblib')"
   ]
  },
