   "source": [
    "# Correlación entre sensores — ¿redundancia?\n",
    "corr = train[sensor_cols].corr()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10,8))\n",
    "sns.heatmap(corr, cmap='coolwarm', vmin=-1, vmax=1, ax=ax, square=True,\n",
    "            cbar_kws={'shrink':0.8})\n",
    "ax.set_title('Correlación entre sensores (train)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# pares muy correlacionados\n",
    "pairs = []\n",
    "for i in range(len(corr.columns)):\n",
    "    for j in range(i+1, len(corr.columns)):\n",
    "        v = corr.iloc[i,j]\n",
    "        if abs(v) > 0.9:\n",
    "            pairs.append((corr.columns[i], corr.columns[j], round(v,2)))\n",
    "\n",
    "print(f'Pares |r|>0.9: {len(pairs)}')\n",
    "for p in pairs[:12]:\n",
    "    print(f'  {p[0]} — {p[1]}: r={p[2]}')"
   ]
  },
  {
