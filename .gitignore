# environment
.venv/
*.egg-info/
# `build/` anclado a la raiz: sin anclar capturaba `scripts/build/`, que tiene
# dos scripts versionados.
/build/
dist/
# secrets — never commit real env values; .env.example templates only.
.env
.env.local
.env.*.local
*.pem
*.key

# python
__pycache__/
*.py[cod]
.pytest_cache/

# datasets and archives — never commit 15 GB
# `archive/` anclado a la raíz para no ocultar carpetas homónimas dentro del
# repo. OpenSpec (incluidas sus specs archivadas) se queda en local.
/archive/
archive.zip
*.h5

# but keep the keras artifact that ships with the demo
!models/bilstm_ds02.keras

# oversized FD001 boosters (regenerable from notebook_nasa_fd001.ipynb; the DS02
# demo does not need them, and 89 MB in git is not acceptable)
models/rf_FD001_baseline.joblib
models/lgb_FD001_baseline.joblib
models/xgb_FD001_baseline.joblib

# scratch / generated
*.executed.ipynb
_exec_*.log
_api.log
_ablate_meta.log
_exec_v3.log
_v3_*.log
nb_exec_*.log
# numbered execution logs (02_exec.log, 03_exec.log, ...) from any notebook dir
*_exec.log
probe_*.log
cells_*.txt
_probe_*.npy
_probe_*.h5

# streamlit — keep the theme, never the secrets
# Ignore the directory *contents*, not the directory, so the negation applies:
# git does not descend into an ignored directory, so `.streamlit/` + `!…/file`
# silently keeps the file ignored.
.streamlit/*
!.streamlit/config.toml

# instrumentos P0/P1
_p0_*.log
_p1_*.log
_p1_*.npz

# local backups — never part of the deliverable
copiaSeguridad*.zip
copiaseguridad*.zip
copiaSeguridadv*/
copiacuadernos/
*.bak
notebooks/ds02_ensemble/artifacts/
# cadena de estado de los cuadernos de clase (la regenera el 04)
notebooks/artifacts_c/

# root duplicates of DS02 bundle — canonical lives in models/
/ensemble.joblib
/scaler.joblib

# retrain execution logs (nbconvert) — generated, not deliverable
retrain_*.log

# Obsidian app state — user-specific, not part of the vault content
MLProyectVault/.obsidian/
# jupyter checkpoints — generated
.ipynb_checkpoints/

# scratch notebooks and dumps
_run_v3.ipynb
nbconvert_output.txt
cell_counts.txt

# MLflow file store — text metadata only; artifacts and trash are never committed.
# Excepción trackeada a propósito: `artifacts/.gitkeep` de cada run (git no
# versiona directorios vacíos y MLflow 3.18 exige el directorio para reconocer
# el run en un clon limpio). Se añaden con `git add -f`.
mlruns/**/artifacts/
mlruns/.trash/
# live notebook tracking — local only, never the deliverable
mlruns-live/

# local pre-notebook backups (2026-11-09; the rerun is a smoke test, not evidence)
*.bak-2026-11-09
resultados.bak-2026-11-09/
notebooks/artifacts_c.bak-2026-11-09/

# tool caches
.atl/
.freebuff/
.hermes/
# local agent skill packs and generated scratch captures — never deliverable
.agents/
scratch/

# fleet records persisted by the Streamlit UI (per-machine state)
app/registros_flota.json
app/registros_sesiones/
app/registros_flota.json.bak
app/registros_n8n.json

# Export crudo de n8n: lleva el chat ID de Telegram y los IDs reales de las
# credenciales. El canónico saneado es `n8n/flujo.json`.
n8n/DS02 Decision MIA-3.json

# respaldos que deja conftest al apartar los registros (flota y sesiones)
*.hermes-respaldo

# class material (notebooks/ds02_ensemble/RequisitosClase/Ejemplos) — not part of
# the deliverable: regenerable exercise folders and their data
notebooks/ds02_ensemble/RequisitosClase/Ejemplos/

# Datos crudos: nunca en git (HDF5 de 2,3 GB; su SHA va en el manifiesto).
# `data/processed/` SÍ se versiona por LFS: un clon limpio corre los tests de
# clase sin necesitar el HDF5 ni regenerar nada.
data/raw/
data/processed/*.log
# resultados/: se versionan los CSV/PNG citados por README y tests; los logs no.
resultados/*
!resultados/*.csv
!resultados/*.png
resultados/*.log
!resultados/bundle_c_train.log
track_clase/models/

# documentacion local: se queda en disco, no se versiona
MLProyectVault/
/costes_reales_aeronauticos.md

# respaldos y salidas de herramienta del deck (2026-11-15): quedan en disco,
# no son entregables
docs/presentacion/_archivo/
docs/presentacion/_backup/
docs/presentacion/_audit_shots/
docs/presentacion/_audit.json
docs/presentacion/_audit_slides.txt

# copia de seguridad de los cuadernos (version previa a la edicion del markdown)
notebooks/notebook_backup/

# skill packs instalados por el agente y su lock
.claude/
skills-lock.json

# OpenSpec: cuaderno de trabajo local (SDD), no forma parte de la entrega
openspec/

# Material de defensa: se queda en local, no se versiona
docs/defensa/
docs/chuleta-defensa.md

# Presentación: solo el PDF exportado entra en git; HTML, fotos y assets quedan
# en local (pesan 9,7 MB y no son reproducibles desde el repo)
docs/presentacion/*
!docs/presentacion/*.pdf
